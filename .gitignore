# Entorno y dependencias
.venv/
node_modules/
frontend/dist/

# Datos crudos: se regeneran con scripts/download_data.sh (~420 MB)
# Se conserva la estructura de carpetas (.gitkeep), no los archivos.
data/raw/*
!data/raw/*/
data/raw/*/*
!data/raw/*/.gitkeep
data/interim/

# Temporales de ejecución
.run/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Sistema
.DS_Store
Thumbs.db

# Credenciales
.env
.env.*
!.env.example

AGROSV_FULL_BACKUP. tar.gz
agrosv_fase0.tar.gz

AGROSV_FULL_BACKUP. tar.gz
agrosv_fase0.tar.gz

# Respaldos locales
AGROSV_FULL_BACKUP*
agrosv_fase0*

# Muestras: no versionar rasters ni comprimidos de gran tamano
# (el hash queda en data/manifests/phase3_samples.json)
data/samples/**/*.tif
data/samples/**/*.pbf
data/samples/**/*.zip

# Fase 4: base de consulta y rasteres derivados son regenerables
# (hash, receta y linaje quedan en data/manifests/)
data/validated/*.sqlite
data/validated/*.sqlite-wal
data/validated/*.sqlite-shm
data/validated/**/*.tif
